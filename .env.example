# Postgres: direct, or Supabase SESSION pooler (port 5432). Do not use the transaction pooler (6543).
DATABASE_URL=postgresql://user:password@host:5432/postgres
ANTHROPIC_API_KEY=
# MICRODRAMA_ANTHROPIC_API_KEY=   (accepted instead, where ANTHROPIC_API_KEY is reserved)
OPENAI_API_KEY=            # optional: only if you set image_provider, embedding_provider or a language-model role to openai (see docs/IMAGE_MODELS.md)
ELEVENLABS_API_KEY=
FAL_KEY=
R2_ACCOUNT_ID=
# R2_ENDPOINT=https://<account id>.r2.cloudflarestorage.com   (may be used instead of R2_ACCOUNT_ID)
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
PUBLIC_BASE_URL=https://example.com   # the address fal calls back on: https://<host>/webhooks/fal
PUBLIC_HOST=example.com               # the host name Caddy serves and gets a certificate for
SESSION_SECRET=change-me
# 1 = fixtures only, nothing paid is called. Set 0 in production (and set every key above).
DRY_RUN=1
WORKER_CONCURRENCY=4
MEDIA_TMP_DIR=/tmp/microdrama
# Optional
# SKIP_PACK_KINDS=          (test only; see docs/OPEN_SOURCE_TEST_SUBSTITUTES.md)
# IMAGE_BACKEND= / EMBEDDING_BACKEND= / VOICE_BACKEND=   (test only: never set in production)
# LIVE_LLM_ROLES=story,writer,originality,director,copy   (demo only, with DRY_RUN=1: these roles call the real model; see docs/LIVE_STORY_DEMO.md)
